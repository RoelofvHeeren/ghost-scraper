# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ghostscraper"

# Redis
REDIS_URL="redis://localhost:6379"

# API
API_PORT=8080
API_BASE_URL="http://localhost:8080"

# Nextdoor Account (Template)
NEXTDOOR_EMAIL="your_email@example.com"
NEXTDOOR_PASSWORD="your_password"
NEXTDOOR_CITY="Tampa"
NEXTDOOR_HEADLESS=false

# Proxy
PROXY_ENABLED=false
PROXY_SERVER="http://user:pass@host:port"

# OpenAI
OPENAI_API_KEY=""

# Twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_DEFAULT_NUMBER=""
TWILIO_WEBHOOK_SECRET="change_me_to_random_secret"

# Safety / Posting
AUTO_POSTING_ENABLED=false
AUTO_POSTING_MAX_PER_ACCOUNT_PER_DAY=4
AUTO_POSTING_MIN_DELAY_SECONDS=120
