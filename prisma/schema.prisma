generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SourceType {
  NEXTDOOR
  REDDIT
  FACEBOOK
  CRAIGSLIST
  MANUAL_IMPORT
}

enum LeadStatus {
  NEW
  NOTIFIED
  CONTACTED
  CALLED
  BOOKED
  WON
  LOST
  NOT_A_FIT
}

enum AccountStatus {
  ACTIVE
  PAUSED
  BANNED
  NEEDS_LOGIN
  NEEDS_REVIEW
}

enum ActionType {
  SCRAPE
  SCORE
  ROUTE
  POST_REPLY
  LOGIN
  ERROR
}

model Client {
  id          String   @id @default(cuid())
  name        String
  createdAt   DateTime @default(now())

  services    ClientService[]
  areas       ClientServiceArea[]
  leads       Lead[]

  twilioNumber String?
}

model ClientService {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id])
  serviceType   String
  includeWords  String[]
  excludeWords  String[]
  minValueUsd   Int?

  createdAt     DateTime @default(now())
}

model ClientServiceArea {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])

  city        String
  state       String?
  zipCodes    String[]
  radiusMiles Int?

  createdAt   DateTime @default(now())
}

model Source {
  id          String    @id @default(cuid())
  type        SourceType
  name        String
  enabled     Boolean   @default(true)
  config      Json      // { "monitorNearby": true, "monitorGroups": ["url1", "url2"], "keywords": [...] }
  pollSeconds Int       @default(300)

  createdAt   DateTime  @default(now())
  candidates  LeadCandidate[]
  connectorState ConnectorState?
  assignedBots BotSourceAssignment[]
}

model BotAccount {
  id              String        @id @default(cuid())
  platform        SourceType
  username        String
  password        String?       // Encrypt? Or use only session
  email           String?
  
  status          AccountStatus @default(ACTIVE)
  sessionData     Json?         // { cookies, localStorage, fingerprint }
  proxyUrl        String?
  
  // Relationships
  campaignId      String?
  campaign        Campaign?     @relation(fields: [campaignId], references: [id])
  
  assignedSources BotSourceAssignment[]
  
  cityMatches     String[]      // List of cities this account covers
  latitude        Float?
  longitude       Float?
  
  lastLoginAt     DateTime?
  lastCaptchaAt   DateTime?
  loginErrorCount Int           @default(0)
  dailyPostCount  Int           @default(0)
  dailyScrapeCount Int          @default(0)
  maxDailyPosts   Int           @default(10)
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model BotSourceAssignment {
  id         String     @id @default(cuid())
  botId      String
  bot        BotAccount @relation(fields: [botId], references: [id], onDelete: Cascade)
  sourceId   String
  source     Source     @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  
  priority   Int        @default(0)  // For ordering which sources to poll first
  createdAt  DateTime   @default(now())
  
  @@unique([botId, sourceId])
  @@index([botId])
  @@index([sourceId])
}

model ConnectorState {
  id              String    @id @default(cuid())
  sourceId        String    @unique
  source          Source    @relation(fields: [sourceId], references: [id])
  
  cursorData      Json?     // e.g. { after: "t3_xyz" }
  lastSeenExternalId String?
  
  lastRunAt       DateTime?
  lastSuccessAt   DateTime?
  errorCount      Int       @default(0)
  
  updatedAt       DateTime  @updatedAt
}

model AutomationLog {
  id          String      @id @default(cuid())
  action      ActionType
  
  sourceId    String?
  candidateId String?
  leadId      String?
  
  status      String      // SUCCESS, FAILURE
  message     String?
  screenshotUrl String?
  metadata    Json?
  
  createdAt   DateTime    @default(now())
}

model LeadCandidate {
  id          String    @id @default(cuid())
  sourceId    String
  source      Source    @relation(fields: [sourceId], references: [id])

  externalId  String?
  url         String?
  title       String?
  body        String
  author      String?
  postedAt    DateTime?
  cityHint    String?
  raw         Json?

  dedupHash   String    @unique
  createdAt   DateTime  @default(now())

  lead        Lead?
}

model Lead {
  id            String     @id @default(cuid())
  clientId      String
  client        Client     @relation(fields: [clientId], references: [id])

  candidateId   String     @unique
  candidate     LeadCandidate @relation(fields: [candidateId], references: [id])

  serviceType   String?
  score         Int        @default(0)
  reasons       Json?
  suggestedReply String?

  status        LeadStatus @default(NEW)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  phoneTrackingNumber String?
  callEvents    CallEvent[]
}

model ReplyTemplate {
  id          String   @id @default(cuid())
  name        String
  templateText String
  tone        String?  // casual, professional
  tags        String[] // [plumbing, tampa]
  variationGroupId String?
  
  createdAt   DateTime @default(now())
}

model CallEvent {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id])

  from      String?
  to        String?
  duration  Int?
  recordingUrl String?

  createdAt DateTime @default(now())
}

model Campaign {
  id          String   @id @default(cuid())
  name        String
  persona     String   @default("BUSINESS") // "BUSINESS" | "COMMUNITY"
  status      String   @default("PAUSED")   // "ACTIVE" | "PAUSED"
  
  steps       CampaignStep[]
  bots        BotAccount[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CampaignStep {
  id            String   @id @default(cuid())
  campaignId    String
  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  order         Int      // Step sequence number (0, 1, 2...)
  delayMinutes  Int      // Wait before executing this step
  content       String   @db.Text // Message template
  
  createdAt     DateTime @default(now())
  
  @@index([campaignId, order])
}

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique // e.g., "TEXTVERIFIED_API_KEY"
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LearnedSelector {
  id          String   @id @default(cuid())
  platform    SourceType
  stepName    String   // e.g., "Entering Credentials", "Handling Address"
  selector    String   // The CSS selector or attribute identifier
  type        String   // "aria-label", "placeholder", "id", "text", "css"
  
  hitCount    Int      @default(0) // How many times this selector worked
  lastUsedAt  DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([platform, stepName, selector])
}
